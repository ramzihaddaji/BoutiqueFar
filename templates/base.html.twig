<!DOCTYPE html>
<html lang="fr" class="h-100">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Atelier Boutique{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><circle cx=%2250%22 cy=%2250%22 r=%2240%22 fill=%22%23A8422B%22/></svg>">
        
        <!-- Google Fonts : Plus Jakarta Sans (typographie simple et moderne) -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

        <!-- Bootstrap 5 Grid & Utilities -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        
        <!-- Feuille de style Identitaire -->
        <link rel="stylesheet" href="{{ asset('css/shop.css') }}">
        
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="d-flex flex-column h-100">
        <!-- Navigation Principale -->
        <header class="site-header">
            <div class="container">
                <nav class="navbar navbar-expand-lg site-navbar px-0">
                    <a class="brand-title" href="{{ path('public_home') }}">
                        <span class="brand-dot"></span>
                        <span>Atelier Boutique</span>
                    </a>

                    <button class="navbar-toggler border-0 shadow-none px-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Menu principal">
                        <span class="small fw-bold text-uppercase" style="font-family: var(--font-heading); letter-spacing: 0.05em;">Menu</span>
                    </button>
                    
                    <div class="collapse navbar-collapse" id="navbarMain">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                            <li class="nav-item">
                                <a class="site-nav-link {% if app.request.attributes.get('_route') == 'public_home' %}active{% endif %}" href="{{ path('public_home') }}">
                                    Accueil
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="site-nav-link {% if 'public_category' in app.request.attributes.get('_route') %}active{% endif %}" href="{{ path('public_category_index') }}">
                                    Rayons
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="site-nav-link {% if 'public_article' in app.request.attributes.get('_route') %}active{% endif %}" href="{{ path('public_article_index') }}">
                                    Tous les articles
                                </a>
                            </li>
                        </ul>
                        
                        <!-- Recherche Rapide -->
                        <form class="d-flex me-lg-3 my-2 my-lg-0" role="search" method="get" action="{{ path('public_article_index') }}">
                            <div class="input-group">
                                <input class="form-control form-control-sm" type="search" name="q" placeholder="Rechercher..." value="{{ app.request.query.get('q') }}" aria-label="Rechercher un article">
                                <button class="btn btn-sm btn-editorial" type="submit" aria-label="Lancer la recherche">
                                    Chercher
                                </button>
                            </div>
                        </form>
                        
                        <!-- Espace Gestion -->
                        <ul class="navbar-nav">
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item dropdown">
                                    <a class="site-nav-link dropdown-toggle text-dark fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Administration
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border" style="border-radius: var(--radius-md);">
                                        <li><a class="dropdown-item py-2" href="{{ path('admin_dashboard') }}">Tableau de bord</a></li>
                                        <li><a class="dropdown-item py-2" href="{{ path('admin_category_index') }}">Gérer les catégories</a></li>
                                        <li><a class="dropdown-item py-2" href="{{ path('admin_article_index') }}">Gérer les articles</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item py-2 text-danger" href="{{ path('app_logout') }}">Déconnexion</a></li>
                                    </ul>
                                </li>
                            {% else %}
                                <li class="nav-item">
                                    <a class="site-nav-link" href="{{ path('app_login') }}">
                                        Accès Pro
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </nav>
            </div>
        </header>

        <!-- Messages Flash -->
        <div class="container mt-3">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' or label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: var(--radius-md);">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <!-- Corps de Page -->
        <main class="flex-shrink-0 my-4">
            {% block body %}{% endblock %}
        </main>

        <!-- Pied de page -->
        <footer class="site-footer">
            <div class="container">
                <div class="row g-4 align-items-center">
                    <div class="col-md-7">
                        <span class="brand-title mb-2">
                            <span class="brand-dot"></span> Atelier Boutique
                        </span>
                        <p class="text-muted small mb-0" style="max-width: 48ch;">
                            Catalogue d'articles en stock. Chaque demande de disponibilité est transmise et confirmée directement avec notre atelier sur WhatsApp.
                        </p>
                    </div>
                    <div class="col-md-5 text-md-end text-muted small">
                        <span>Paiement & expédition confirmés au contact direct.</span>
                        <div class="mt-1">&copy; {{ "now"|date("Y") }} Atelier Boutique.</div>
                    </div>
                </div>
            </div>
        </footer>

        <!-- Bootstrap 5 Bundle JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
