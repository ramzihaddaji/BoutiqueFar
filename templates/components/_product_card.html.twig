<div class="card h-100 product-card shadow-sm">
    <div class="product-image-container position-relative">
        {% if article.image %}
            <img src="{{ asset('uploads/articles/' ~ article.image) }}" alt="{{ article.name }}" loading="lazy">
        {% else %}
            <div class="text-muted d-flex flex-column align-items-center justify-content-center p-3">
                <i class="bi bi-image fs-1 opacity-50"></i>
                <small class="mt-1">Pas d'image</small>
            </div>
        {% endif %}
        <span class="position-absolute top-0 start-0 m-2 badge bg-primary">
            {{ article.category.name }}
        </span>
    </div>
    <div class="card-body d-flex flex-column">
        <h5 class="card-title text-truncate" title="{{ article.name }}">{{ article.name }}</h5>
        <p class="card-text text-muted small flex-grow-1">
            {{ article.description ? article.description|slice(0, 90) ~ (article.description|length > 90 ? '...' : '') : 'Aucune description disponible.' }}
        </p>
        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
            <span class="fs-5 fw-bold text-dark">{{ article.price }} €</span>
            <div class="btn-group">
                <a href="{{ path('public_article_show', {id: article.id}) }}" class="btn btn-outline-secondary btn-sm" title="Voir les détails">
                    <i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('public_demande_create', {id: article.id}) }}" class="btn btn-whatsapp btn-sm d-flex align-items-center gap-1" title="Demander sur WhatsApp">
                    <i class="bi bi-whatsapp"></i> Demander
                </a>
            </div>
        </div>
    </div>
</div>

