<article class="product-card">
    <a href="{{ path('public_article_show', {id: article.id}) }}" class="product-thumb-wrap text-decoration-none">
        {% if article.image %}
            <img src="{{ asset('uploads/articles/' ~ article.image) }}" alt="{{ article.name }}" class="product-thumb" loading="lazy">
        {% else %}
            <div class="product-thumb-placeholder">
                <span class="product-thumb-placeholder-tag">#{{ article.id }}</span>
                <span>Visuel en atelier</span>
            </div>
        {% endif %}
    </a>
    
    <div class="p-3 d-flex flex-column flex-grow-1">
        <div class="product-category-label">
            <a href="{{ path('public_category_show', {id: article.category.id}) }}" class="text-decoration-none text-muted">
                {{ article.category.name }}
            </a>
        </div>
        
        <h3 class="product-title">
            <a href="{{ path('public_article_show', {id: article.id}) }}" class="text-decoration-none text-dark">
                {{ article.name }}
            </a>
        </h3>
        
        <p class="product-desc">
            {{ article.description ? article.description|slice(0, 85) ~ (article.description|length > 85 ? '…' : '') : 'Pièce disponible en boutique.' }}
        </p>
        
        <div class="d-flex justify-content-between align-items-center pt-2 mt-auto border-top" style="border-color: var(--color-line) !important;">
            <span class="product-price">{{ article.price }} €</span>
            <a href="{{ path('public_demande_create', {id: article.id}) }}" class="btn btn-whatsapp btn-sm" aria-label="Demander la disponibilité de {{ article.name }}">
                Disponibilité
            </a>
        </div>
    </div>
</article>
