{% extends 'base.html.twig' %}

{% block title %}Nos rayons — Atelier Boutique{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/categories.css') }}">
{% endblock %}

{% block body %}
<div class="categories-page">
    <div class="container">

        <nav class="categories-breadcrumb" aria-label="Fil d’Ariane">
            <a href="{{ path('public_home') }}">Accueil</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Rayons</span>
        </nav>

        <header class="categories-hero">
            <div class="categories-hero-copy">
                <span class="categories-eyebrow">
                    <span class="categories-eyebrow-line"></span>
                    Explorez notre univers
                </span>
                <h1>Un univers, <em>plusieurs</em> façons de découvrir.</h1>
                <p>Parcourez nos rayons et trouvez facilement les articles qui correspondent à vos envies.</p>
            </div>

            <div class="categories-hero-mark" aria-hidden="true">
                <span class="categories-mark-circle"></span>
                <span class="categories-mark-text">ATELIER<br> BOUTIQUE</span>
            </div>
        </header>

        {% if root_categories is empty %}
            <section class="categories-empty">
                <div class="categories-empty-icon" aria-hidden="true">✳</div>
                <h2>Aucun rayon pour le moment</h2>
                <p>Notre catalogue sera bientôt enrichi. Revenez nous rendre visite !</p>
                <a href="{{ path('public_home') }}" class="categories-button">Retour à l’accueil <span aria-hidden="true">→</span></a>
            </section>
        {% else %}
            <div class="categories-section-heading">
                <div>
                    <span class="categories-section-kicker">Le catalogue</span>
                    <h2>Nos rayons</h2>
                </div>
                <span class="categories-total">
                    {{ root_categories|length }}
                    {{ root_categories|length > 1 ? 'rayons' : 'rayon' }}
                </span>
            </div>

            <div class="categories-grid">
                {% for root in root_categories %}
                    {% set active_children = root.children|filter(child => child.active) %}

                    <article class="category-card" style="--card-index: {{ loop.index0 }};">
                        <div class="category-card-top">
                            <span class="category-card-number">{{ '%02d'|format(loop.index) }}</span>
                            <span class="category-card-count">
                                {{ active_children|length }}
                                {{ active_children|length > 1 ? 'sous-rayons' : 'sous-rayon' }}
                            </span>
                        </div>

                        <div class="category-card-content">
                            <h3>
                                <a href="{{ path('public_category_show', {id: root.id}) }}">
                                    {{ root.name }}
                                </a>
                            </h3>

                            {% if root.description %}
                                <p class="category-card-description">{{ root.description }}</p>
                            {% else %}
                                <p class="category-card-description category-card-description-muted">
                                    Découvrez notre sélection dans ce rayon.
                                </p>
                            {% endif %}
                        </div>

                        {% if active_children is not empty %}
                            <div class="category-subcategories">
                                <span class="category-subcategories-label">Explorer les sous-rayons</span>
                                <div class="category-subcategories-list">
                                    {% for child in active_children %}
                                        <a href="{{ path('public_category_show', {id: child.id}) }}" class="subcategory-chip">
                                            {{ child.name }}
                                            <span aria-hidden="true">↗</span>
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        {% else %}
                            <div class="category-no-subcategories">
                                <span aria-hidden="true">✦</span>
                                Rayon à découvrir
                            </div>
                        {% endif %}

                        <a href="{{ path('public_category_show', {id: root.id}) }}" class="category-card-link">
                            <span>Découvrir le rayon</span>
                            <span class="category-card-arrow" aria-hidden="true">→</span>
                        </a>
                    </article>
                {% endfor %}
            </div>
        {% endif %}

        <footer class="categories-bottom-note">
            <span class="categories-bottom-star" aria-hidden="true">✳</span>
            <p>Une belle découverte commence parfois par un simple rayon.</p>
        </footer>
    </div>
</div>
{% endblock %}
