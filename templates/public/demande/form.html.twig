{% extends 'base.html.twig' %}

{% block title %}Demande de Disponibilité — {{ article.name }}{% endblock %}

{% block body %}
<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <ul class="breadcrumb-atelier mb-3">
                <li><a href="{{ path('public_home') }}">Accueil</a></li>
                <li><a href="{{ path('public_article_show', {id: article.id}) }}">{{ article.name }}</a></li>
                <li class="active">Demande</li>
            </ul>

            <div class="form-card">
                <!-- En-tête Contextuel -->
                <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom" style="border-color: var(--color-line) !important;">
                    {% if article.image %}
                        <img src="{{ article_image_url(article.image) }}" alt="{{ article.name }}" class="border" style="width: 58px; height: 58px; object-fit: cover; border-radius: var(--radius-sm);">
                    {% else %}
                        <div class="border d-flex align-items-center justify-content-center font-heading fw-bold text-muted bg-light" style="width: 58px; height: 58px; border-radius: var(--radius-sm); font-size: 0.8rem;">
                            #{{ article.id }}
                        </div>
                    {% endif %}
                    <div>
                        <span class="product-category-label d-block">{{ article.category.name }}</span>
                        <h1 class="h5 fw-bold mb-0 text-dark">{{ article.name }}</h1>
                        <span class="product-price fs-6">{{ article.price }} €</span>
                    </div>
                </div>

                <p class="text-muted small mb-4">
                    Indiquez vos coordonnées pour initier la demande. Vos informations sont enregistrées côté boutique, puis transmises dans votre message WhatsApp prérempli.
                </p>

                <!-- Formulaire mono-colonne propre -->
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.clientName, 'Votre nom complet', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.clientName, {'attr': {'class': 'form-control' ~ (form.clientName.vars.valid ? '' : ' is-invalid'), 'placeholder': 'Ex. Camille Martin'}}) }}
                        {{ form_errors(form.clientName) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.phone, 'Numéro de téléphone portable', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.phone, {'attr': {'class': 'form-control' ~ (form.phone.vars.valid ? '' : ' is-invalid'), 'placeholder': 'Ex. 06 12 34 56 78'}}) }}
                        {{ form_errors(form.phone) }}
                        <div class="form-text small text-muted">Sert à l'identification de votre commande.</div>
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.city, 'Ville de livraison ou de retrait', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.city, {'attr': {'class': 'form-control' ~ (form.city.vars.valid ? '' : ' is-invalid'), 'placeholder': 'Ex. Bordeaux, Paris, Nantes...'}}) }}
                        {{ form_errors(form.city) }}
                    </div>

                    <button type="submit" class="btn btn-whatsapp w-100 py-3" style="font-size: 1rem;">
                        Valider et continuer sur WhatsApp
                    </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
