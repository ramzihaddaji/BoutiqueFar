{% extends 'base.html.twig' %}

{% block title %}Demande de disponibilité - {{ article.name }}{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('public_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('public_article_show', {id: article.id}) }}">{{ article.name }}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Demande</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <!-- En-tête récapitulatif du produit -->
                <div class="card-header bg-dark text-white p-4">
                    <div class="d-flex align-items-center gap-3">
                        {% if article.image %}
                            <img src="{{ asset('uploads/articles/' ~ article.image) }}" alt="{{ article.name }}" class="rounded-2" style="width: 64px; height: 64px; object-fit: cover;">
                        {% else %}
                            <div class="bg-secondary rounded-2 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                <i class="bi bi-bag text-white fs-3"></i>
                            </div>
                        {% endif %}
                        <div>
                            <span class="badge bg-secondary mb-1">{{ article.category.name }}</span>
                            <h5 class="mb-0 fw-bold">{{ article.name }}</h5>
                            <span class="text-success-emphasis fw-bold fs-5">{{ article.price }} €</span>
                        </div>
                    </div>
                </div>

                <!-- Formulaire coordonnées client -->
                <div class="card-body p-4 p-md-5">
                    <div class="alert alert-light border d-flex gap-2 align-items-center mb-4">
                        <i class="bi bi-info-circle text-primary fs-4"></i>
                        <small class="text-muted">
                            Renseignez vos coordonnées pour que nous puissions préparer votre commande. Vous serez ensuite dirigé vers WhatsApp avec votre message prêt à être envoyé.
                        </small>
                    </div>

                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.clientName, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.clientName, {'attr': {'class': 'form-control' ~ (form.clientName.vars.valid ? '' : ' is-invalid')}}) }}
                            {{ form_errors(form.clientName) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.phone, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.phone, {'attr': {'class': 'form-control' ~ (form.phone.vars.valid ? '' : ' is-invalid')}}) }}
                            {{ form_errors(form.phone) }}
                            <div class="form-text">Ce numéro servira à vous contacter en cas de besoin.</div>
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.city, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.city, {'attr': {'class': 'form-control' ~ (form.city.vars.valid ? '' : ' is-invalid')}}) }}
                            {{ form_errors(form.city) }}
                        </div>

                        <button type="submit" class="btn btn-whatsapp btn-lg w-100 py-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-whatsapp fs-5"></i> Valider et continuer sur WhatsApp
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
