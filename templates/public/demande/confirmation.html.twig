{% extends 'base.html.twig' %}

{% block title %}Demande Confirmée - {{ article.name }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 text-center">
            <!-- Icône de Succès -->
            <div class="mb-4">
                <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-check2-circle fs-1"></i>
                </div>
            </div>

            <h1 class="h2 fw-bold text-dark mb-2">Votre demande est enregistrée !</h1>
            <p class="text-muted lead mb-4">
                Merci <strong>{{ demande.clientName }}</strong>. Vos informations ont bien été prises en compte dans notre système.
            </p>

            <!-- Récapitulatif -->
            <div class="card shadow-sm border-0 rounded-4 text-start p-4 mb-4 bg-white">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Récapitulatif de la demande</h5>
                <div class="row g-2 small">
                    <div class="col-4 text-muted">Article :</div>
                    <div class="col-8 fw-semibold text-dark">{{ article.name }} ({{ article.price }} €)</div>

                    <div class="col-4 text-muted">Référence :</div>
                    <div class="col-8">#{{ article.id }}</div>

                    <div class="col-4 text-muted">Contact :</div>
                    <div class="col-8">{{ demande.phone }}</div>

                    <div class="col-4 text-muted">Ville :</div>
                    <div class="col-8">{{ demande.city }}</div>
                </div>
            </div>

            <!-- Bouton d'action WhatsApp -->
            <div class="p-4 bg-success-subtle rounded-4 border border-success-subtle mb-4">
                <h5 class="fw-bold text-success-emphasis mb-2">Dernière étape : Confirmer sur WhatsApp</h5>
                <p class="text-secondary small mb-3">
                    Pour finaliser l'échange, cliquez ci-dessous afin d'ouvrir WhatsApp avec votre message prérempli et l'envoyer à notre administrateur.
                </p>
                <a href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg px-4 py-3 shadow d-inline-flex align-items-center gap-2">
                    <i class="bi bi-whatsapp fs-4"></i> Ouvrir WhatsApp et envoyer le message
                </a>
            </div>

            <div>
                <a href="{{ path('public_home') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Retour à la boutique
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
