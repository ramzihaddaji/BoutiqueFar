{% extends 'base.html.twig' %}

{% block title %}Demande Enregistrée — {{ article.name }}{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="form-card text-center">
                <!-- Confirmation discrète et claire -->
                <div class="mb-3 d-inline-flex align-items-center justify-content-center text-white" style="width: 48px; height: 48px; background: var(--color-action); border-radius: var(--radius-sm); font-size: 1.25rem;">
                    &#10003;
                </div>

                <h1 class="h3 fw-bold text-dark mb-2">Votre demande est enregistrée !</h1>
                <p class="text-muted small mb-4">
                    Merci {{ demande.clientName }}. Votre demande est bien consignée pour <strong>{{ article.name }}</strong>.
                </p>

                <!-- Récapitulatif -->
                <div class="p-3 mb-4 text-start bg-light border" style="border-radius: var(--radius-sm); border-color: var(--color-line) !important;">
                    <div class="d-flex justify-content-between py-1 small">
                        <span class="text-muted">Article</span>
                        <span class="fw-bold text-dark">{{ article.name }}</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 small">
                        <span class="text-muted">Prix unitaire</span>
                        <span class="fw-bold text-dark">{{ article.price }} €</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 small">
                        <span class="text-muted">Référence atelier</span>
                        <span>#{{ article.id }}</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 small border-top mt-2 pt-2">
                        <span class="text-muted">Contact renseigné</span>
                        <span>{{ demande.phone }} &mdash; {{ demande.city }}</span>
                    </div>
                </div>

                <!-- Action décisive : WhatsApp -->
                <div class="mb-4">
                    <p class="small text-muted mb-3">
                        L'application WhatsApp va s'ouvrir avec votre message prérempli à destination de notre équipe.
                    </p>
                    <a href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp w-100 py-3" style="font-size: 1rem;">
                        Ouvrir WhatsApp et envoyer le message
                    </a>
                </div>

                <a href="{{ path('public_home') }}" class="small text-muted text-decoration-none">
                    &larr; Retourner à l'accueil
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
