{% extends 'base.html.twig' %}

{% block title %}{{ article.name }} — Atelier Boutique{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/article-show.css') }}">
{% endblock %}

{% block body %}
<div class="as-page">
    <div class="container">

        <nav class="as-breadcrumb" aria-label="Fil d’Ariane">
            <a href="{{ path('public_home') }}">Accueil</a>
            <span aria-hidden="true">/</span>
            <a href="{{ path('public_category_index') }}">Rayons</a>
            {% for crumb in breadcrumbs %}
                <span aria-hidden="true">/</span>
                <a href="{{ path('public_category_show', {id: crumb.id}) }}">{{ crumb.name }}</a>
            {% endfor %}
            <span aria-hidden="true">/</span>
            <span class="as-breadcrumb-current" aria-current="page">{{ article.name }}</span>
        </nav>

        <article class="as-frame">
            <div class="as-media">
                {% if article.image %}
                    <img src="{{ asset('uploads/articles/' ~ article.image) }}" alt="{{ article.name }}" class="as-photo" loading="eager" fetchpriority="high">
                {% else %}
                    <div class="as-placeholder" role="img" aria-label="Photographie à venir">
                        <span class="as-placeholder-letter" aria-hidden="true">{{ article.name|slice(0, 1)|upper }}</span>
                        <span class="as-placeholder-text">Photographie en cours d’atelier</span>
                    </div>
                {% endif %}
            </div>

            <div class="as-summary">
                <div class="as-summary-top">
                    <div class="as-meta-row">
                        <a href="{{ path('public_category_show', {id: article.category.id}) }}" class="as-category">
                            {{ article.category.name }}
                        </a>
                        <span class="as-stock-tag">En stock à l’atelier</span>
                    </div>

                    <h1 class="as-title">{{ article.name }}</h1>

                    <div class="as-price" aria-label="Prix : {{ article.price|number_format(2, ',', ' ') }} euros">
                        {{ article.price|number_format(2, ',', ' ') }} €
                    </div>

                    <section class="as-details" aria-labelledby="asDetailsTitle">
                        <h2 id="asDetailsTitle">Détails &amp; spécifications</h2>
                        <div class="as-description">
                            {{ article.description ? article.description|nl2br : 'Pièce artisanale enregistrée sans note complémentaire.' }}
                        </div>
                    </section>
                </div>

                <aside class="as-action" aria-label="Demande de disponibilité">
                    <div class="as-action-head">
                        <span class="as-action-title">Demande directe</span>
                        <span class="as-action-note">Sans inscription</span>
                    </div>
                    <p>
                        Renseignez votre nom, votre ville et votre téléphone : nous vérifions la pièce avant de vous répondre sur WhatsApp.
                    </p>
                    <a href="{{ path('public_demande_create', {id: article.id}) }}" class="as-cta">
                        Demander la disponibilité <span aria-hidden="true">→</span>
                    </a>
                    <ul class="as-assurances">
                        <li>Pièce en stock</li>
                        <li>Réponse sur WhatsApp</li>
                        <li>Aucun paiement en ligne</li>
                    </ul>
                </aside>
            </div>
        </article>

        <div class="as-bottom-links">
            <a href="{{ path('public_category_show', {id: article.category.id}) }}"><span aria-hidden="true">←</span> Retour au rayon {{ article.category.name }}</a>
            <a href="{{ path('public_article_index') }}">Voir tout l’inventaire <span aria-hidden="true">→</span></a>
        </div>
    </div>
</div>
{% endblock %}
