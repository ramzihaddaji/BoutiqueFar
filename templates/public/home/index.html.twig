{% extends 'base.html.twig' %}

{% block title %}Atelier Boutique — Vitrine des Pièces en Stock{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <!-- Typographie éditoriale -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..700&display=swap" rel="stylesheet">

    <!-- Styles spécifiques à la page d'accueil -->
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
{% endblock %}

{% block body %}
    {% if showcase_articles is empty %}
        <section class="showcase-empty-state" aria-labelledby="emptyShowcaseHeading">
            <h1 id="emptyShowcaseHeading" class="showcase-empty-title">
                Aucun article en stock pour le moment
            </h1>

            <p class="showcase-empty-desc">
                Nos pièces sélectionnées sont actuellement indisponibles ou réservées.
                Vous pouvez parcourir l'ensemble de notre inventaire pour découvrir nos créations.
            </p>

            <a href="{{ path('public_article_index') }}" class="showcase-cta-primary">
                Voir tous les articles
            </a>
        </section>
    {% else %}
        <section
            class="showcase-viewport{% if showcase_articles|length == 1 %} is-single{% endif %}"
            role="region"
            aria-roledescription="carrousel"
            aria-label="Vitrine des articles disponibles"
        >
            <div class="showcase-live-region visually-hidden" aria-live="off" aria-atomic="true"></div>

            <div class="showcase-track">
                {% for article in showcase_articles %}
                    <article
                        class="showcase-slide{% if loop.first %} is-active{% endif %}"
                        role="group"
                        aria-roledescription="diapositive"
                        aria-label="{{ loop.index }} sur {{ showcase_articles|length }}"
                        {% if not loop.first %}aria-hidden="true" inert{% endif %}
                    >
                        <!-- Informations de l'article -->
                        <div class="showcase-panel-text">
                            <div class="showcase-text-content">
                                <div class="showcase-category">
                                    {{ article.category.name }}
                                </div>

                                <h1 class="showcase-title">
                                    {{ article.name }}
                                </h1>

                                <div class="showcase-price-row">
                                    <span
                                        class="showcase-price"
                                        aria-label="Prix : {{ article.price|number_format(2, ',', ' ') }} euros"
                                    >
                                        {{ article.price|number_format(2, ',', ' ') }} €
                                    </span>

                                    <span class="showcase-stock-tag">
                                        En stock à l'atelier
                                    </span>
                                </div>

                                <p class="showcase-desc">
                                    {% if article.description %}
                                        {{ article.description|length > 140
                                            ? article.description|slice(0, 140) ~ '…'
                                            : article.description
                                        }}
                                    {% else %}
                                        Pièce disponible immédiatement dans notre atelier.
                                        Demandez confirmation et détails auprès de notre équipe.
                                    {% endif %}
                                </p>

                                <div class="showcase-actions">
                                    <a
                                        href="{{ path('public_demande_create', { id: article.id }) }}"
                                        class="showcase-cta-primary"
                                    >
                                        Demander la disponibilité
                                    </a>

                                    <a
                                        href="{{ path('public_article_show', { id: article.id }) }}"
                                        class="showcase-cta-secondary"
                                    >
                                        Voir la fiche
                                    </a>
                                </div>
                            </div>

                            {% if showcase_articles|length > 1 %}
                                <div class="showcase-controls-bar">
                                    <div
                                        class="showcase-dots"
                                        role="tablist"
                                        aria-label="Sélectionner un article"
                                    >
                                        {% for dot in showcase_articles %}
                                            <button
                                                type="button"
                                                class="showcase-dot"
                                                role="tab"
                                                data-index="{{ loop.index0 }}"
                                                aria-label="Afficher l'article {{ loop.index }} : {{ dot.name }}"
                                                aria-selected="{{ loop.first ? 'true' : 'false' }}"
                                                {% if loop.first %}aria-current="true"{% endif %}
                                            ></button>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>

                        <!-- Image de l'article -->
                        <div class="showcase-panel-media">
                            {% if article.image %}
                                <img
                                    src="{{ article_image_url(article.image) }}"
                                    alt="{{ article.name }}"
                                    class="showcase-img"
                                    {% if loop.first %}
                                        fetchpriority="high"
                                        loading="eager"
                                    {% else %}
                                        loading="lazy"
                                    {% endif %}
                                >
                            {% else %}
                                <div class="showcase-placeholder" aria-hidden="true">
                                    <span class="showcase-placeholder-letter">
                                        {{ article.name|slice(0, 1)|upper }}
                                    </span>
                                </div>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>

        <aside class="showcase-catalogue-bar">
            <p class="showcase-catalogue-text">
                Pas trouvé ?
                <a href="{{ path('public_article_index') }}" class="showcase-catalogue-link">
                    Voir tous les articles
                </a>
            </p>
        </aside>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/showcase.js') }}" defer></script>
{% endblock %}
