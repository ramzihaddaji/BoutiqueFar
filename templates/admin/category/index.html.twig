{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Catégories - Administration{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Catégories & Rayons</h1>
        <p class="text-muted small mb-0">Arborescence complète des catégories et sous-catégories</p>
    </div>
    <a href="{{ path('admin_category_new') }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Créer une catégorie
    </a>
</div>

<div class="card admin-card bg-white shadow-sm overflow-hidden">
    <div class="card-body p-0">
        {% if categories is empty %}
            <div class="p-5 text-center text-muted">
                <i class="bi bi-folder-x fs-1 d-block mb-2 opacity-50"></i>
                Aucune catégorie n'a encore été créée.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">ID</th>
                            <th>Nom & Hiérarchie</th>
                            <th>Sous-catégories</th>
                            <th>Type</th>
                            <th>Statut</th>
                            <th class="text-end" style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cat in categories %}
                            <tr>
                                <td class="text-muted small">#{{ cat.id }}</td>
                                <td>
                                    <strong><i class="bi bi-folder-fill text-warning me-1"></i>{{ cat.name }}</strong>
                                    {% if cat.description %}
                                        <div class="text-muted small text-truncate" style="max-width: 320px;">{{ cat.description }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if cat.children is not empty %}
                                        <span class="badge bg-primary-subtle text-primary">{{ cat.children|length }} enfant(s)</span>
                                    {% else %}
                                        <span class="badge bg-light text-muted border">0 enfant</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if cat.isLeaf %}
                                        <span class="badge bg-success-subtle text-success">Feuille (reçoit articles)</span>
                                    {% else %}
                                        <span class="badge bg-secondary-subtle text-secondary">Nœud parent</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if cat.active %}
                                        <span class="badge bg-success">Active</span>
                                    {% else %}
                                        <span class="badge bg-danger">Inactive</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('admin_category_show', {id: cat.id}) }}" class="btn btn-outline-secondary" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('admin_category_edit', {id: cat.id}) }}" class="btn btn-outline-primary" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {# Affichage indenté des sous-catégories directes #}
                            {% for child in cat.children %}
                                <tr class="table-light bg-opacity-25">
                                    <td class="text-muted small ps-4">#{{ child.id }}</td>
                                    <td class="ps-4">
                                        <span class="text-muted me-1">↳</span>
                                        <strong>{{ child.name }}</strong>
                                        <span class="text-muted small ms-1">(Parent: {{ cat.name }})</span>
                                    </td>
                                    <td>
                                        {% if child.children is not empty %}
                                            <span class="badge bg-primary-subtle text-primary">{{ child.children|length }} enfant(s)</span>
                                        {% else %}
                                            <span class="badge bg-light text-muted border">0</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if child.isLeaf %}
                                            <span class="badge bg-success-subtle text-success">Feuille</span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-secondary">Nœud</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if child.active %}
                                            <span class="badge bg-success">Active</span>
                                        {% else %}
                                            <span class="badge bg-danger">Inactive</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="{{ path('admin_category_show', {id: child.id}) }}" class="btn btn-outline-secondary" title="Détails">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="{{ path('admin_category_edit', {id: child.id}) }}" class="btn btn-outline-primary" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

