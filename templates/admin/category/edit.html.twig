{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier {{ category.name }} - Administration{% endblock %}

{% block admin_content %}
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Admin</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_category_index') }}">Catégories</a></li>
            <li class="breadcrumb-item active" aria-current="page">Modifier {{ category.name }}</li>
        </ol>
    </nav>
    <h1 class="h3 fw-bold text-dark mb-1">Modifier la Catégorie</h1>
    <p class="text-muted small">Édition de #{{ category.id }} - {{ category.name }}</p>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card admin-card bg-white p-4 shadow-sm">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.name, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'form-control' ~ (form.name.vars.valid ? '' : ' is-invalid')}}) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.parent, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.parent, {'attr': {'class': 'form-select' ~ (form.parent.vars.valid ? '' : ' is-invalid')}}) }}
                    {{ form_errors(form.parent) }}
                    <div class="form-text">Attention : déplacer une catégorie vers un parent cyclique ou vers une catégorie hébergeant des articles sera rejeté.</div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control' ~ (form.description.vars.valid ? '' : ' is-invalid')}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="mb-4 form-check form-switch">
                    {{ form_widget(form.active, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(form.active, null, {'label_attr': {'class': 'form-check-label fw-semibold'}}) }}
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('admin_category_index') }}" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary px-4">Mettre à jour</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

