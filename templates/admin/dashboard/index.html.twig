{% extends 'admin/base_admin.html.twig' %}

{% block title %}Tableau de Bord - Administration{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Tableau de Bord</h1>
        <p class="text-muted small mb-0">Vue d'ensemble de l'activité du catalogue commercial</p>
    </div>
    <div class="btn-group">
        <a href="{{ path('admin_article_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Nouvel Article
        </a>
        <a href="{{ path('admin_category_new') }}" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-folder-plus me-1"></i> Nouvelle Catégorie
        </a>
    </div>
</div>

<!-- Cartes Statistiques -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card admin-card p-3 bg-white shadow-sm">
            <div class="d-flex align-items-center">
                <div class="bg-primary-subtle text-primary p-3 rounded-3 me-3">
                    <i class="bi bi-folder2 fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted text-uppercase small mb-1">Catégories</h6>
                    <h3 class="fw-bold mb-0 text-dark">{{ total_categories }}</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card admin-card p-3 bg-white shadow-sm">
            <div class="d-flex align-items-center">
                <div class="bg-success-subtle text-success p-3 rounded-3 me-3">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted text-uppercase small mb-1">Articles Totaux</h6>
                    <h3 class="fw-bold mb-0 text-dark">{{ total_articles }}</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card admin-card p-3 bg-white shadow-sm">
            <div class="d-flex align-items-center">
                <div class="bg-info-subtle text-info p-3 rounded-3 me-3">
                    <i class="bi bi-check2-circle fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted text-uppercase small mb-1">Articles Disponibles</h6>
                    <h3 class="fw-bold mb-0 text-dark">{{ available_articles }}</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dernières Demandes Clients -->
<div class="card admin-card shadow-sm bg-white">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-whatsapp text-success me-2"></i>Dernières Demandes Clients</h5>
        <span class="badge bg-light text-muted border">{{ latest_demandes|length }} demande(s) récente(s)</span>
    </div>
    <div class="card-body p-0">
        {% if latest_demandes is empty %}
            <div class="p-4 text-center text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                Aucune demande client n'a été enregistrée pour le moment.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Téléphone</th>
                            <th>Ville</th>
                            <th>Article demandé</th>
                            <th>Prix</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for demande in latest_demandes %}
                            <tr>
                                <td class="small text-muted">{{ demande.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="fw-semibold">{{ demande.clientName }}</td>
                                <td>
                                    <a href="https://wa.me/{{ demande.phone|replace({' ': '', '+': '', '-': ''}) }}" target="_blank" class="text-decoration-none text-success">
                                        <i class="bi bi-whatsapp me-1"></i>{{ demande.phone }}
                                    </a>
                                </td>
                                <td><span class="badge bg-light text-dark border">{{ demande.city }}</span></td>
                                <td>
                                    <a href="{{ path('admin_article_show', {id: demande.article.id}) }}" class="text-decoration-none fw-semibold">
                                        {{ demande.article.name }}
                                    </a>
                                </td>
                                <td class="fw-bold">{{ demande.article.price }} €</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

