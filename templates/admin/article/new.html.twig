{% extends 'admin/base_admin.html.twig' %}

{% block title %}Créer un Article - Administration{% endblock %}

{% block admin_content %}
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Admin</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_article_index') }}">Articles</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nouveau</li>
        </ol>
    </nav>
    <h1 class="h3 fw-bold text-dark mb-1">Créer un Article</h1>
    <p class="text-muted small">Ajoutez un nouveau produit au catalogue</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card admin-card bg-white p-4 shadow-sm">
            {{ form_start(form) }}
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        {{ form_label(form.name, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'form-control' ~ (form.name.vars.valid ? '' : ' is-invalid')}}) }}
                        {{ form_errors(form.name) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_label(form.price, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        <div class="input-group">
                            {{ form_widget(form.price, {'attr': {'class': 'form-control' ~ (form.price.vars.valid ? '' : ' is-invalid')}}) }}
                            <span class="input-group-text">€</span>
                        </div>
                        {{ form_errors(form.price) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.category, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.category, {'attr': {'class': 'form-select' ~ (form.category.vars.valid ? '' : ' is-invalid')}}) }}
                    {{ form_errors(form.category) }}
                    <div class="form-text">Rappel : seules les catégories finales (sans sous-catégories) et actives sont éligibles.</div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control' ~ (form.description.vars.valid ? '' : ' is-invalid')}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.imageFile, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.imageFile, {'attr': {'class': 'form-control' ~ (form.imageFile.vars.valid ? '' : ' is-invalid')}}) }}
                    {{ form_errors(form.imageFile) }}
                    <div class="form-text">Formats autorisés : JPEG, PNG, WEBP (5 Mo maximum).</div>
                </div>

                <div class="mb-4 form-check form-switch">
                    {{ form_widget(form.available, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(form.available, null, {'label_attr': {'class': 'form-check-label fw-semibold'}}) }}
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('admin_article_index') }}" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary px-4">Enregistrer l'article</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

